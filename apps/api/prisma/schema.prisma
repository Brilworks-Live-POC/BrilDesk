generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  superadmin
  admin
  manager
  agent
}

enum ConversationStatus {
  open
  waiting
  resolved
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum SenderType {
  contact
  agent
  system
}

enum MessageStatus {
  sent
  delivered
  read
  failed
}

enum RoutingType {
  round_robin
  least_busy
  manual
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String?
  role          UserRole  @default(agent)
  teamId        String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  team          Team?     @relation(fields: [teamId], references: [id])
  conversations Conversation[] @relation("AssignedAgent")
  messages      Message[]
  quickReplies  QuickReply[]
  auditLogs     AuditLog[]

  @@index([teamId])
  @@index([email])
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  conversations Conversation[]
  routingRules  RoutingRule[]
  quickReplies  QuickReply[]
}

model Conversation {
  id              String             @id @default(cuid())
  waContactPhone  String
  waContactName   String?
  status          ConversationStatus @default(open)
  priority        String             @default("medium")
  assignedToId    String?
  teamId          String?
  lastMessageAt   DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  assignedTo  User?     @relation("AssignedAgent", fields: [assignedToId], references: [id])
  team        Team?     @relation(fields: [teamId], references: [id])
  messages    Message[]

  @@index([status, assignedToId])
  @@index([lastMessageAt(sort: Desc)])
  @@index([waContactPhone])
  @@index([teamId])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  body           String?
  mediaUrl       String?
  mediaType      String?
  waMessageId    String?          @unique
  senderType     SenderType
  senderId       String?
  status         MessageStatus    @default(sent)
  timestamp      DateTime         @default(now())
  createdAt      DateTime         @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderId], references: [id])

  @@index([conversationId, timestamp])
  @@index([waMessageId])
}

model RoutingRule {
  id       String      @id @default(cuid())
  teamId   String
  type     RoutingType @default(round_robin)
  isActive Boolean     @default(true)
  config   Json        @default("{}")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  team Team @relation(fields: [teamId], references: [id])

  @@index([teamId])
}

model QuickReply {
  id          String   @id @default(cuid())
  title       String
  body        String
  teamId      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team      Team? @relation(fields: [teamId], references: [id])
  createdBy User  @relation(fields: [createdById], references: [id])

  @@index([teamId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
