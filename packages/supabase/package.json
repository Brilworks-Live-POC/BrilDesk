{
  "name": "@brildesk/supabase",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./types": {
      "types": "./src/database.types.ts",
      "default": "./src/database.types.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --local > src/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.0"
  },
  "devDependencies": {
    "@brildesk/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "supabase": "^2.22.0",
    "typescript": "^5.8.0"
  }
}
