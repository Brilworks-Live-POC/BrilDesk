{
  "name": "brildesk",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @brildesk/api db:generate",
    "db:migrate": "pnpm --filter @brildesk/api db:migrate",
    "db:seed": "pnpm --filter @brildesk/api db:seed",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:migrate": "supabase migration up",
    "supabase:gen-types": "pnpm --filter @brildesk/supabase gen:types",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "supabase": "^2.22.0",
    "turbo": "^2.5.0",
    "prettier": "^3.5.0"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "supabase",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
