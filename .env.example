# =========================
# BrilDesk Environment Vars
# =========================

# ---- Supabase ----
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="<your-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"
SUPABASE_JWT_SECRET="<your-jwt-secret>"

# Browser-visible (prefixed for Next.js / Vite)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"

# ---- Legacy (kept for Prisma migration period) ----
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Redis (used by BullMQ workers — will be removed in Phase 4)
REDIS_URL="redis://localhost:6379"

# Google OAuth (configured in supabase/config.toml for local, Dashboard for prod)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_VERIFY_TOKEN="generate-a-random-string"
WA_APP_SECRET=""

# Zoho Bigin (Phase 2)
BIGIN_CLIENT_ID=""
BIGIN_CLIENT_SECRET=""
BIGIN_REDIRECT_URI="http://localhost:3001/api/integrations/bigin/callback"

# API
API_PORT=3001
API_URL="http://localhost:3001"

# Frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="http://localhost:3001"
