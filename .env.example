# =========================
# BrilDesk Environment Vars
# =========================

# ---- Supabase ----
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="<your-anon-key>"
SUPABASE_SERVICE_ROLE_KEY="<your-service-role-key>"
SUPABASE_JWT_SECRET="<your-jwt-secret>"

# Browser-visible (prefixed for Next.js)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<your-anon-key>"

# ---- Google OAuth ----
# Configured in supabase/config.toml for local, Supabase Dashboard for prod
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- WhatsApp Cloud API ----
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_VERIFY_TOKEN="generate-a-random-string"
WA_APP_SECRET=""

# ---- Email (Resend) ----
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM_ADDRESS="hello@brildesk.com"

# ---- Cloudflare ----
# API Worker (wrangler secrets)
# CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN set in CI
# Worker secrets: SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
#   WHATSAPP_VERIFY_TOKEN, WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID,
#   RESEND_API_KEY, RESEND_WEBHOOK_SECRET

# ---- URLs ----
NEXT_PUBLIC_API_URL="http://localhost:8787"
